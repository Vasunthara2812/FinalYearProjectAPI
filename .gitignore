## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# Rider
.idea/

# VS Code
.vscode/

# Node modules (if using npm in MVC project)
node_modules/

# wwwroot generated files (if using bundling/minification)
wwwroot/lib/
wwwroot/dist/

# Logs
*.log

# SQL Server files
*.mdf
*.ldf

# IIS Express
/.vs/
/IISExpress

# Publish output
publish/
*.pubxml
*.publishproj

# Azure
PublishScripts/

# Resharper
_ReSharper*/
*.DotSettings.user

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# Coverlet
coverage*
*.coverage
*.coveragexml

# Test Results
TestResults/

# OS generated files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.*

# Secrets (important for ASP.NET Core)
secrets.json

# NuGet
*.nupkg
.nuget/packages/
